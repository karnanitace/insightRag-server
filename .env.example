# Environment Variables — InsightRAG Server
# Copy this to .env and fill in your values

PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/insighrag?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here_change_in_production
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=text-embedding-004
LLM_MODEL=gemini-1.5-flash

# Password reset
CLIENT_URL=http://localhost:5173
# Resend (optional — if RESEND_API_KEY is unset, reset links are logged to the server console)
RESEND_API_KEY=
# Must be on a domain verified in Resend; onboarding@resend.dev works for testing (sends only to your own account email)
EMAIL_FROM="InsightRAG <onboarding@resend.dev>"

# Demo account (POST /api/auth/demo): a shared login for visitors. Set DEMO_ENABLED=false to turn it off.
DEMO_ENABLED=true
DEMO_EMAIL=demo@insightrag.app
DEMO_NAME="Demo User"
